PORT=3000
DATABASE_URL=postgresql://widget_user:widget_password@localhost:5432/widget_platform

AUTH_SECRET=replace-with-local-development-secret

GEO_PROVIDER_A_ENABLED=true
GEO_PROVIDER_B_ENABLED=true

# Localhost IPs cannot be geolocated.
# Development testing only:
GEO_LOOKUP_IP_OVERRIDE=8.8.8.8

SIDE_EFFECT_ENABLED=true
SIDE_EFFECT_FORCE_FAIL=false